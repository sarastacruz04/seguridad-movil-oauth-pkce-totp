{
  "name": "backend-auth",
  "version": "1.0.0",
  "description": "Backend OAuth2+PKCE, JWT y Step-Up TOTP (laboratorio UniSabana)",
  "main": "dist/server.js",
  "scripts": {
    "test": "SILENT_LOGS=1 node --import tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
