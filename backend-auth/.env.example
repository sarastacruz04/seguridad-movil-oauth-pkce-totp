# Copia este archivo a .env y ajusta los valores.  (cp .env.example .env)

PORT=3000
HOST=0.0.0.0

# Usuario demo: estudiante@unisabana.edu.co
DEMO_PASSWORD=Sabana2026!

# Semilla TOTP en Base32 (la misma que se escanea en /mfa/enroll).
TOTP_SECRET=JBSWY3DPEHPK3PXP

# Clave HMAC para firmar los JWT (HS256). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si se deja vacía se genera una aleatoria en cada arranque (los tokens dejan de valer al reiniciar).
JWT_SECRET=

# Tiempos de vida (para demostrar el silent refresh en vivo puedes bajar ACCESS_TOKEN_TTL_SECONDS a 15)
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_DAYS=30
STEP_UP_TTL_SECONDS=300
ELEVATED_TTL_SECONDS=600
AUTH_CODE_TTL_SECONDS=60
REPLAY_TTL_SECONDS=90

# Página /mfa/enroll con el QR de la semilla. SOLO PARA DESARROLLO.
DEV_ENROLL_PAGE=true
